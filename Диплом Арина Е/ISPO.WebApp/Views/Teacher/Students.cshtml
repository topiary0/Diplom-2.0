@model TeacherStudentsViewModel
@{
    ViewData["Title"] = "Студенты";
}

<section class="panel">
    <div class="panel-heading">
        <h2>Добавить студента</h2>
        <a class="btn ghost" asp-controller="Teacher" asp-action="Index">Назад в панель</a>
    </div>

    <form asp-action="CreateStudent" method="post" class="grid-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="input-block">
            <label asp-for="Form.LastName">Фамилия</label>
            <input asp-for="Form.LastName" />
            <span asp-validation-for="Form.LastName" class="field-validation"></span>
        </div>
        <div class="input-block">
            <label asp-for="Form.FirstName">Имя</label>
            <input asp-for="Form.FirstName" />
            <span asp-validation-for="Form.FirstName" class="field-validation"></span>
        </div>
        <div class="input-block">
            <label asp-for="Form.MiddleName">Отчество</label>
            <input asp-for="Form.MiddleName" />
            <span asp-validation-for="Form.MiddleName" class="field-validation"></span>
        </div>
        <div class="input-block">
            <label asp-for="Form.BirthDate">Дата рождения</label>
            <input asp-for="Form.BirthDate" type="date" />
            <span asp-validation-for="Form.BirthDate" class="field-validation"></span>
        </div>
        <div class="input-block">
            <label asp-for="Form.Email">Электронная почта</label>
            <input asp-for="Form.Email" placeholder="name.surname@spbstu.ru" />
        </div>
        <div class="input-block">
            <label asp-for="Form.Phone">Телефон</label>
            <input asp-for="Form.Phone" />
            <span asp-validation-for="Form.Phone" class="field-validation"></span>
        </div>
        <div class="input-block">
            <label asp-for="Form.InitialPassword">Пароль для входа</label>
            <input asp-for="Form.InitialPassword" type="password" />
        </div>
        <div class="input-block">
            <label asp-for="Form.GroupId">Группа</label>
            <select asp-for="Form.GroupId">
                <option value="">Выберите группу</option>
                @foreach (var group in Model.Groups)
                {
                    <option value="@group.Id">@group.GroupCode - @group.Name</option>
                }
            </select>
            <span asp-validation-for="Form.GroupId" class="field-validation"></span>
        </div>
        <div class="input-block full">
            <p class="field-tip">После сохранения студент сможет войти по адресу электронной почты и паролю.</p>
        </div>
        <div class="input-block actions-row">
            <button type="submit" class="btn primary">Добавить студента</button>
        </div>
    </form>
</section>

<section class="panel">
    <h2>Управление учетными записями</h2>
    <p class="field-tip">Таблица студентов скрыта по вашему запросу. При необходимости список можно вернуть.</p>
    <div class="actions-strip">
        <a class="btn ghost" asp-controller="Teacher" asp-action="Index">Вернуться в кабинет преподавателя</a>
    </div>
</section>

